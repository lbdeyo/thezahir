# Stripe Configuration Template
# Copy this file to .env.local and replace the placeholder values with your actual Stripe keys
# 
# To create .env.local, run:
# cp env.template .env.local
# Then edit .env.local with your actual keys

# Stripe Secret Key
# Get this from: Stripe Dashboard > Developers > API keys
# For testing: Use sk_test_... (Test mode)
# For production: Use sk_live_... (Live mode)
STRIPE_SECRET_KEY=sk_test_YOUR_TEST_SECRET_KEY_HERE

# Stripe Webhook Secret
# For local testing: Get from `stripe listen --forward-to localhost:3000/api/stripe/webhook` command
# For production: Get from Stripe Dashboard > Developers > Webhooks > [Your endpoint] > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Optional: Publishable Key (not required for server-side operations)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE

# SMTP (for donation confirmation emails via nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=donations@yourdomain.org
# ADMIN_EMAILS=admin@yourdomain.org,other@yourdomain.org
# SITE_URL=https://www.yourdomain.org

# HubSpot contact form (native form via Forms API — not Collected Forms)
# Portal ID matches the tracking script in app/layout.tsx
HUBSPOT_PORTAL_ID=244639378
# Create Marketing > Forms > "Website Contact" with fields:
# email, firstname, lastname, message (multi-line text)
# Single checkbox: "Add me to The Zahir's mailing list" (for contact + footer signups)
# Copy internal names from HubSpot field settings (API uses names without hyphens)
# Copy the form GUID from Share > Embed code (data-form-id) into Vercel env
HUBSPOT_CONTACT_FORM_ID=
# HUBSPOT_FIELD_MESSAGE=contactmessage
# HUBSPOT_FIELD_MAILING_LIST=mailinglistoptin

